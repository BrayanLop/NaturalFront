{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://naturalback.vip/v2/api",
        "EXPO_PUBLIC_PLATAFORMA_URL": "https://brar.bia.solutions"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://naturalback.vip/v2/api",
        "EXPO_PUBLIC_PLATAFORMA_URL": "https://brar.bia.solutions"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
