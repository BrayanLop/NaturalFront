# Ejemplo de variables de entorno para este proyecto.
# Copia este archivo a .env y completa los valores sensibles en tu entorno local.

EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_TIMEOUT=

# URL de Brar (servicio de plataforma del superadmin)
EXPO_PUBLIC_PLATAFORMA_URL=

# URL base del backend de Citas (sin barra final). Si se deja vacía, el módulo de citas se oculta.
EXPO_PUBLIC_CITAS_API_URL=
